+/// The names a block-local foreign module (`extern "C" { ... }`) introduces
+/// into its enclosing block's *value* namespace, exactly as a block-local
+/// `fn`/`static` item does (see `visit_block`): those are its `fn` and
+/// `static` items, which are callable/referenceable by a naked name and so
+/// shadow a same-named module-level item. A foreign `type` (type namespace
+/// only, like a named-field struct) and a foreign `macro`/`verbatim` are
+/// deliberately never returned: a `type` cannot be a naked call target and a
+/// macro is not a callable name, so neither shadows a same-named function.
+/// `ForeignItem` is `#[non_exhaustive]`, so the wildcard below is fail-closed
+/// only in the sense that it ignores names this adapter does not recognize --
+/// it never marks the enclosing block conservative, which would (wrongly)
+/// block unrelated names merely because a foreign module is present.
+fn value_namespace_names(items: &[ForeignItem]) -> Vec<String> {
+    items
+        .iter()
+        .filter_map(|item| match item {
+            ForeignItem::Fn(nested) => Some(nested.sig.ident.to_string()),
+            ForeignItem::Static(nested) => Some(nested.ident.to_string()),
+            _ => None,
+        })
+        .collect()
+}
