+/// The names a block-local `extern` foreign module declares in its enclosing
+/// block's value namespace. Real Rust hoists foreign-module items into the
+/// block like any other item, and a foreign `fn` or `static` puts its name
+/// in the *value* namespace -- so each one shadows a same-named
+/// module-level function for an unqualified call in the block exactly as a
+/// block-local `fn` or `static` item would. A foreign module's `type`
+/// declarations go to the *type* namespace only, so they are deliberately
+/// never hoisted here (the same reason a named-field struct is not, see
+/// `visit_block`). Unlike a glob `use` this is a closed, exact set: a
+/// foreign module cannot declare a name we fail to enumerate, so a block
+/// whose foreign module declares only *other* names shadows nothing at all
+/// and blocks no resolution.
+fn foreign_mod_bindings(extern_block: &ItemForeignMod) -> Vec<String> {
+    extern_block
+        .items
+        .iter()
+        .filter_map(|item| match item {
+            ForeignItem::Fn(function) => Some(function.sig.ident.to_string()),
+            ForeignItem::Static(statik) => Some(statik.ident.to_string()),
+            _ => None,
+        })
+        .collect()
+}
