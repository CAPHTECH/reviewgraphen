+/// The value-namespace names a block-local `extern` block's items shadow in
+/// its enclosing block, and whether any item is opaque enough that the names
+/// it might introduce cannot be enumerated. A foreign `fn` and a foreign
+/// `static` both sit in the *value* namespace exactly as a block-local
+/// `fn`/`static` item does (see `visit_block`), so their names are hoisted and
+/// shadow a same-named module-level function for a naked call in the block. A
+/// foreign `type` is *type*-namespace only -- the same distinction that keeps
+/// a named-field struct from being hoisted in `visit_block` -- so it can never
+/// be a call target and never shadows a same-named callable; it is provably
+/// safe and contributes nothing. A foreign `Macro` or `Verbatim` item is
+/// opaque in exactly the way a glob `use` or a `Pat::Macro`/`Pat::Verbatim`
+/// binding is (see those callers): it may declare a `fn`/`static` of *any*
+/// name, so the whole block must be marked conservatively unresolved rather
+/// than let a naked call fall through to a same-named module item.
+/// `ForeignItem` is `#[non_exhaustive]`, so the wildcard arm fails *closed*
+/// on any future variant: an unrecognized shape might bind any name, so it is
+/// treated as unresolvable, never as provably safe the way a bare `_ => {}`
+/// would.
+fn foreign_item_value_bindings(items: &[ForeignItem]) -> (Vec<String>, bool) {
+    let mut names = Vec::new();
+    let mut has_unresolvable = false;
+    for item in items {
+        match item {
+            ForeignItem::Fn(nested) => names.push(nested.sig.ident.to_string()),
+            ForeignItem::Static(nested) => names.push(nested.ident.to_string()),
+            ForeignItem::Type(_) => {}
+            ForeignItem::Macro(_) | ForeignItem::Verbatim(_) => has_unresolvable = true,
+            _ => has_unresolvable = true,
+        }
+    }
+    (names, has_unresolvable)
+}
