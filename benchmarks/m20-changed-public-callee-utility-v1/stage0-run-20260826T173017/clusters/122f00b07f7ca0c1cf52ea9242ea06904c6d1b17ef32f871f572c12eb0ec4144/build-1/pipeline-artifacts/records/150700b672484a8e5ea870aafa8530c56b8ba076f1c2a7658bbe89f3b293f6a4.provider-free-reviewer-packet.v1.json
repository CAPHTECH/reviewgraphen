{"instruction":"Return the fixed provider-free abstention using the supplied closed schema.","payloads":[{"byte_length":39,"encoding":"utf-8","media_type":"text/x-rust; charset=utf-8","payload_id":"source-payload:sha256:417c9c000a9332faeba6802110ed19ba2028bf2023f059ed0aafb5a38e06b7b1","sha256":"sha256:b02ce10b776f9492e663946a0ee7eaee0d58b4784080c655e4209c8260180085","text":"// SPDX-License-Identifier: Apache-2.0\n"},{"byte_length":473,"encoding":"utf-8","media_type":"text/x-rust; charset=utf-8","payload_id":"source-payload:sha256:b82582509275a8fbe5c732388db666627451e6a883f393275b37bee71c99a024","sha256":"sha256:20d110f28b7b0a680152aa20d433287d8d2b4427dcb271be9b8cf8d56b3650ed","text":"/// The source location of a typed-model failure.\n///\n/// Prefers the span the diagnostic recorded for itself over the enclosing\n/// construct's lowering origin, so the report names the assignment or field\n/// that failed rather than the declaration containing it.\n#[must_use]\npub fn model_error_loc(error: &fsl_core::ModelError) -> Option<Value> {\n    error.span.map_or_else(\n        || origin_loc(error.origin.as_deref()),\n        |span| Some(span.python_loc()),\n    )\n}\n"},{"byte_length":684,"encoding":"utf-8","media_type":"text/x-rust; charset=utf-8","payload_id":"source-payload:sha256:dff0b1cf984ed97e8e6c4c8278bb606b65089bcda99ade7d09b33516a6f3e9a1","sha256":"sha256:50a4754c6a3382869bdbdcf7c3f1cd2dfeddec497728a120634cb89038236d43","text":"/// The source location a typed-model diagnostic carries, if the model bound one\n/// to the offending construct.\n///\n/// The span is read back from the origin the model already recorded; it is\n/// never re-derived or synthesised. A construct with no recorded span yields\n/// `None`, and the caller must leave `loc` absent rather than emit the\n/// `line: 0` sentinel, which would point a repair agent at a location that does\n/// not exist (issue 555).\n#[must_use]\npub fn origin_loc(origin: Option<&fsl_core::OriginChain>) -> Option<Value> {\n    origin\n        .and_then(|origin| origin.primary.as_ref())\n        .and_then(|site| site.span)\n        .map(fsl_syntax::Span::python_loc)\n}\n"},{"byte_length":177,"encoding":"utf-8","media_type":"text/x-rust; charset=utf-8","payload_id":"source-payload:sha256:e9b2ddca07eea34e52dcf080879b7ef356b5c365621bc7c2e4fdca1d492bf010","sha256":"sha256:9be25477684ea5bc772620a51faeb7ebf3129eec6503ebb69a0511d3cc681307","text":"/// Deadlock reporting policy shared by native and browser verification.\n#[derive(Clone, Copy, Debug, Eq, PartialEq)]\npub enum DeadlockMode {\n    Warn,\n    Error,\n    Ignore,\n}\n"}],"response_schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"disposition":{"additionalProperties":false,"properties":{"detail":{"const":"deterministic.abstain@1 does not evaluate semantic properties"},"kind":{"const":"abstention"},"reason":{"const":"required_evidence_unavailable"}},"required":["kind","reason","detail"],"type":"object"},"schema":{"const":"provider-free.source-grounded-abstention@1"},"source_inventory_id":{"const":"source-inventory:sha256:8cd25d08ca6db5008fd1a3dea9f0a1d9ee831fcf5596f4a9e563e6bff9dec013"},"task_id":{"const":"provider-free-review-task:sha256:ed5c55cef4021938aaefd9edbf4ef5f0a871cff1f7b0f92efd002a3f32a08998"}},"required":["schema","task_id","source_inventory_id","disposition"],"type":"object"},"schema":"provider-free.source-grounded-packet@1","source_inventory":{"admitted_sources":[{"bytes":39,"path":"rust/fslc/src/verification_output.rs","payload_id":"source-payload:sha256:417c9c000a9332faeba6802110ed19ba2028bf2023f059ed0aafb5a38e06b7b1","range":{"end_line":1,"start_line":1},"sha256":"sha256:b02ce10b776f9492e663946a0ee7eaee0d58b4784080c655e4209c8260180085","source_id":"source:sha256:298757b20950b49c6e8e4755644fd598d154a383dcf5874fbce2d28384f3f934"},{"bytes":473,"path":"rust/fslc/src/verification_output.rs","payload_id":"source-payload:sha256:b82582509275a8fbe5c732388db666627