{"instruction":"Return the fixed provider-free abstention using the supplied closed schema.","payloads":[{"byte_length":205,"encoding":"utf-8","media_type":"text/x-rust; charset=utf-8","payload_id":"source-payload:sha256:2a2832b785ae21bb1045784abd1aeda2d55f208ee0dc6f6dffdf3729b06cefa7","sha256":"sha256:2337b7c73c61bcddb369613f5b2ba69de703649b960db35389408e1ce0f8d43e","text":"#[derive(Clone, Debug, Eq, PartialEq)]\nenum LogicalType {\n    Int,\n    Bool,\n    Named(String),\n    Map(Box<Self>, Box<Self>),\n    Set(Box<Self>),\n    Seq(Box<Self>),\n    Option(Box<Self>),\n    Unknown,\n}\n"},{"byte_length":39,"encoding":"utf-8","media_type":"text/x-rust; charset=utf-8","payload_id":"source-payload:sha256:417c9c000a9332faeba6802110ed19ba2028bf2023f059ed0aafb5a38e06b7b1","sha256":"sha256:b02ce10b776f9492e663946a0ee7eaee0d58b4784080c655e4209c8260180085","text":"// SPDX-License-Identifier: Apache-2.0\n"},{"byte_length":497,"encoding":"utf-8","media_type":"text/x-rust; charset=utf-8","payload_id":"source-payload:sha256:4452f150d03a5b710258ab26d1c9be7d534bb79c5b92df5311d346e8844952e1","sha256":"sha256:b67d69f3534a4309d701a6b4c011ad9ff16bf091bc7323b0d14305d6a9383db8","text":"    fn scope_for_aggregate(&self, aggregate: &DomainAggregate) -> Result<Scope, CoreError> {\n        aggregate\n            .state\n            .iter()\n            .map(|field| {\n                Ok((\n                    field.name.text.clone(),\n                    Symbol {\n                        kernel_name: state_name(aggregate, &field.name),\n                        ty: self.logical_type(&field.type_name)?,\n                    },\n                ))\n            })\n            .collect()\n    }\n"},{"byte_length":434,"encoding":"utf-8","media_type":"text/x-rust; charset=utf-8","payload_id":"source-payload:sha256:c0655d5377a6d77ec901c337d612cd86670644c81ad79ff56a85d468193ec87c","sha256":"sha256:d82ff14d10de4e9e1b4508509cfcb1ca7951f3f37ccf3a20b42b152f07211617","text":"/// The kernel state variable name a domain aggregate field lowers to\n/// (`{aggregate}_{field}`). Exported so an external corpus sweep can compute\n/// an `evolve` assignment's kernel target from the `DomainSpec` alone,\n/// instead of guessing from generated names (see `event_flag`).\n#[must_use]\npub fn state_name(aggregate: &DomainAggregate, field: &str) -> String {\n    format!(\"{}_{}\", lower_name(&aggregate.name), safe(field))\n}\n"}],"response_schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"disposition":{"additionalProperties":false,"properties":{"detail":{"const":"deterministic.abstain@1 does not evaluate semantic properties"},"kind":{"const":"abstention"},"reason":{"const":"required_evidence_unavailable"}},"required":["kind","reason","detail"],"type":"object"},"schema":{"const":"provider-free.source-grounded-abstention@1"},"source_inventory_id":{"const":"source-inventory:sha256:67b261899c2fb0f5eeb5a0bc1ca7efe741a731b410851da8fe9939596d28b1ac"},"task_id":{"const":"provider-free-review-task:sha256:fb72180c6643ea5db7698d5d0423fcc97e1ca8d74e110f5856ff84af2dc15b52"}},"required":["schema","task_id","source_inventory_id","disposition"],"type":"object"},"schema":"provider-free.source-grounded-packet@1","source_inventory":{"admitted_sources":[{"bytes":205,"path":"rust/fsl-core/src/domain_lowering.rs","payload_id":"source-payload:sha256:2a2832b785ae21bb1045784abd1aeda2d55f208ee0dc6f6dffdf3729b06cefa7","range":{"end_line":30,"start_line":20},"sha256":"sha256:2337b7c73c61bcddb369613f5b2ba69de703649b960db35389408e1ce0f8d43e","source_id":"source:sha256:0e5b30e683fc8f7c304a5ab157aef055c61f79d24660c2904e32fd24a45a3961"},{"bytes":497,"path":"rust/fsl-core/src/domain_lowering.rs","payload_id":"source-payload:sha256:4452f150d03a5b710258ab26d1c9be7d534bb79c5b92df5311d346e8844952e1","range":{"end_line":598,"start_line":584},"sha256":"sha256:b67d69f3534a4309d701a6b4c011ad9ff16bf091bc7323b0d14305d6a9383db8","source_id":"source:sha256:3b7cbc0a