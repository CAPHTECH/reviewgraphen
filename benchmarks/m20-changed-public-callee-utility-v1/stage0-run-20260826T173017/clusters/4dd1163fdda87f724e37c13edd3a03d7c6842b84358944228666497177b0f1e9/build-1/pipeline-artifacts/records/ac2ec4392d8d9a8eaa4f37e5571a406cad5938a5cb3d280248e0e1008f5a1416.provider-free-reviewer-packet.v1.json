{"instruction":"Return the fixed provider-free abstention using the supplied closed schema.","payloads":[{"byte_length":205,"encoding":"utf-8","media_type":"text/x-rust; charset=utf-8","payload_id":"source-payload:sha256:2a2832b785ae21bb1045784abd1aeda2d55f208ee0dc6f6dffdf3729b06cefa7","sha256":"sha256:2337b7c73c61bcddb369613f5b2ba69de703649b960db35389408e1ce0f8d43e","text":"#[derive(Clone, Debug, Eq, PartialEq)]\nenum LogicalType {\n    Int,\n    Bool,\n    Named(String),\n    Map(Box<Self>, Box<Self>),\n    Set(Box<Self>),\n    Seq(Box<Self>),\n    Option(Box<Self>),\n    Unknown,\n}\n"},{"byte_length":39,"encoding":"utf-8","media_type":"text/x-rust; charset=utf-8","payload_id":"source-payload:sha256:417c9c000a9332faeba6802110ed19ba2028bf2023f059ed0aafb5a38e06b7b1","sha256":"sha256:b02ce10b776f9492e663946a0ee7eaee0d58b4784080c655e4209c8260180085","text":"// SPDX-License-Identifier: Apache-2.0\n"},{"byte_length":434,"encoding":"utf-8","media_type":"text/x-rust; charset=utf-8","payload_id":"source-payload:sha256:7d3e2b5021f0b294f371aff18e7d358a4563df2defe6832ec168dbf6d625fcb2","sha256":"sha256:f07abe4e3c8a2da778954f950c5e53912b29dab077d73c343cc659602ad9390d","text":"fn saga_scope(resolver: &Resolver<'_>) -> Scope {\n    resolver\n        .domain\n        .aggregates\n        .iter()\n        .flat_map(|aggregate| aggregate.events.iter())\n        .map(|event| {\n            (\n                event.name.clone(),\n                Symbol {\n                    kernel_name: event_flag(&event.name),\n                    ty: LogicalType::Bool,\n                },\n            )\n        })\n        .collect()\n}\n"},{"byte_length":545,"encoding":"utf-8","media_type":"text/x-rust; charset=utf-8","payload_id":"source-payload:sha256:944bc98407ceb9dee0a6989d47b4c272b4f68efe773cf73d08bb69c5d139448b","sha256":"sha256:17a98b1c85a52101e06d0108fe689c87daa84fc2b56b790a57cb5cb8775b8fb6","text":"/// The kernel one-hot event-occurrence flag name a domain event lowers to\n/// (`event_{event}`). Exported so an external corpus sweep (the #779 saga\n/// step/timeout/compensation \"evolve pairing\" gate) can compute which kernel\n/// variable an event's occurrence flag is from the `DomainSpec` alone,\n/// rather than pattern-matching generated action bodies for an `event_`\n/// prefix — the latter has no `DomainSpec`-side referent to check against.\n#[must_use]\npub fn event_flag(event: &str) -> String {\n    format!(\"event_{}\", safe(event))\n}\n"}],"response_schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"disposition":{"additionalProperties":false,"properties":{"detail":{"const":"deterministic.abstain@1 does not evaluate semantic properties"},"kind":{"const":"abstention"},"reason":{"const":"required_evidence_unavailable"}},"required":["kind","reason","detail"],"type":"object"},"schema":{"const":"provider-free.source-grounded-abstention@1"},"source_inventory_id":{"const":"source-inventory:sha256:e8b0b819a6be1dbef539102014bd8505a67d7956fcfbfa095c58fba0a680b8a3"},"task_id":{"const":"provider-free-review-task:sha256:921d7093d5c4e6be93e90789135b37afe394944faee03250a82aa0c9c0fafc26"}},"required":["schema","task_id","source_inventory_id","disposition"],"type":"object"},"schema":"provider-free.source-grounded-packet@1","source_inventory":{"admitted_sources":[{"bytes":205,"path":"rust/fsl-core/src/domain_lowering.rs","payload_id":"source-payload:sha256:2a2832b785ae21bb1045784abd1aeda2d55f208ee0dc6f6dffdf3729b06cefa7","range":{"end_line":30,"start_line":20},"sha256":"sha256:2337b7c73c61bcddb369613f5b2ba69de703649b960db35389408e1ce0f8d43e","source_id":"source:sha256:0e5b30e683fc8f7c304a5ab157aef055c61f79d24660c2904e32fd24a45a3961"},{"bytes":39,"path":"rust/fsl-core/src/domain_lowering.rs","payload_id":"source-payload:sha256:417c9c000a9332faeba6802110ed19ba2028bf2023f059ed0aafb5a38e06b7b1","range":{"end_line":1,"start_line":1},"sha256":"sha256:b02ce10b776f9492e663946a0ee7eaee0d58b4784080c655e4209c8260180085","source_id":"source:sha256:71122e4e808eb76338955c4fd0d9d4ce61857b6757d8ea59ce7beada1782cb8a"},{"bytes":434,"path":"rust/fsl-core/src/domain_lowering.rs","payload_id":"source-payload:sha256:7d3e2b5021f0b294f371aff18e7d358a4563df2defe6832ec168dbf6d625fcb2","range":{"end_line":2728,"start_line":2712},"sha256":"sha256:f07abe4e3c8a2da778954f950c5e53912b29dab077d73c343cc659602ad9390d","source_id":"source:sha256:7970e5422b8fe67941ba5ac0dfc264dd829beb045f89e5e105374bd77097e758"},{"bytes":545,"path":"rust/fsl-core/src/domain_lowering.rs","payload_id":"source-payload:sha256:944bc98407ceb9dee0a6989d47b4c272b4f68efe773cf73d08bb69c5d139448b","range":{"end_line":228,"start_line":219},"sha256":"sha256:17a98b1c85a52101e06d0108fe689c87daa84fc2b56b790a57cb5cb8775b8fb6","source_id":"source:sha256:8c260f544845c5b7c02a1f8ca213eaa805438eeea4da7be305ce5f5936b1d664"}],"canonical_sha256":"sha256:e8b0b819a6be1dbef539102014bd8505a67d7956fcfbfa095c58fba0a680b8a3","schema":"provider-free.source-inventory@1","source_inventory_id":"source-inventory:sha256:e8b0b819a6be1dbef539102014bd8505a67d7956fcfbfa095c58fba0a680b8a3"},"task_id":"provider-free-review-task:sha256:921d7093d5c4e6be93e90789135b37afe394944faee03250a82aa0c9c0fafc26"}