{"instruction":"Return the fixed provider-free abstention using the supplied closed schema.","payloads":[{"byte_length":473,"encoding":"utf-8","media_type":"text/x-rust; charset=utf-8","payload_id":"source-payload:sha256:02ab1830ee70203b62fdf834ab34e700542ca6fffe22d9a9482d6ed0dd8d20f1","sha256":"sha256:3d13ac508da5af07d1ff4db4a64e21b88ac84fdf322ae57fc216046db8e0f8b0","text":"/// Parses and applies all intrinsic semantic validation.\npub fn parse_execution_topology(\n    input: &str,\n) -> Result<ExecutionTopology, Vec<TopologyValidationFinding>> {\n    let topology: ExecutionTopology = serde_json::from_str(input)\n        .map_err(|error| vec![finding(\"invalid_json\", \"$\", error.to_string())])?;\n    let findings = validate_execution_topology(&topology);\n    if findings.is_empty() {\n        Ok(topology)\n    } else {\n        Err(findings)\n    }\n}\n"},{"byte_length":205,"encoding":"utf-8","media_type":"text/x-rust; charset=utf-8","payload_id":"source-payload:sha256:12fc4de2a7472a0c52779f87fafef710ff17bfbf86a22305dcb66e77e0d9bc9e","sha256":"sha256:142ba9319e57cca6a9a2a6cf1dcbe9a9cd804034a8e79915ed742355c3eb04a7","text":"/// Compilation for inspection, or compilation tied to a canonical accepted review.\n#[derive(Clone, Debug, Eq, PartialEq)]\npub enum CompilationMode {\n    Proposal,\n    Reviewed(ReviewedTopologyBinding),\n}\n"},{"byte_length":74,"encoding":"utf-8","media_type":"text/x-rust; charset=utf-8","payload_id":"source-payload:sha256:410ee34d67bb5ae95e1ab3a37b97654fb1759a159b8eeaa00c0e9eec30e98c66","sha256":"sha256:062b29953efa2e480e002b1ed3112a43d981caf549f5574912aa6e91a8546a17","text":"//! Deterministic lowering from a lint-clean execution-topology proposal.\n"},{"byte_length":250,"encoding":"utf-8","media_type":"text/x-rust; charset=utf-8","payload_id":"source-payload:sha256:5bba73436b813b71e8cee82c82ffefb3caeb18093534871fdbc67e82b56396ec","sha256":"sha256:09a3b0f99141120abde9c49a510a64af268eaae96dff48f2a619d36307ca8ed6","text":"    fn topology() -> ExecutionTopology {\n        crate::execution_topology::parse_execution_topology(include_str!(\n            \"../schemas/experimental/execution.topology.file-review.example.json\"\n        ))\n        .expect(\"topology example\")\n    }\n"},{"byte_length":46,"encoding":"utf-8","media_type":"text/x-rust; charset=utf-8","payload_id":"source-payload:sha256:6d896caa9ea5e92edc9a8cac2846f9cccaf6ea3525b35da3caf043aa97a1e35d","sha256":"sha256:b087dc16363b83418b46ec74b1ae1e76c95f0788d379ab499b4088b57d7056e8","text":"//! Experimental execution-topology contract.\n"},{"byte_length":479,"encoding":"utf-8","media_type":"text/x-rust; charset=utf-8","payload_id":"source-payload:sha256:b2c74ff5ed342fbfbfdf5d3b37a8fac624bf9b25bccd5b11204a51654c573fed","sha256":"sha256:122b1ad966f7f29d418f08cf9d6d7817c76af5dca15b1d7ff630558c4f14d2f2","text":"/// Opaque proof that a topology hash was bound to a reviewed case claim.\n///\n/// Callers cannot construct this value directly. [`reviewed_compilation_mode`]\n/// derives it from the canonical CaseGraphen review log.\n#[derive(Clone, Debug, Eq, PartialEq)]\npub struct ReviewedTopologyBinding {\n    claim_cell_id: String,\n    review_id: String,\n    topology_content_hash: String,\n    case_space_id: String,\n    base_revision_id: String,\n    expansion_proposal_id: Option<String>,\n}\n"},{"byte_length":553,"encoding":"utf-8","media_type":"text/x-rust; charset=utf-8","payload_id":"source-payload:sha256:fd394b52cd2eddd0eb4ebf06e469fc2ad4d08270689ee0683684ee8ce53baf6b","sha256":"sha256:cc8a22cad80bc1e15a78aaecd06d6f8a35ac9e54a4bec23979f0c99aae8d99ff","text":"/// A deployable topology proposal.\n#[derive(Clone, Debug, Deserialize, Eq, PartialEq, Serialize)]\n#[serde(deny_unknown_fields)]\npub struct ExecutionTopology {\n    pub schema: String,\n    pub schema_version: u32,\n    pub topology_id: String,\n    pub case_space_id: String,\n    pub nodes: Vec<TopologyNode>,\n    pub edges: Vec<TopologyEdge>,\n    pub verification_policy_ids: Vec<String>,\n    pub budget_policy_ids: Vec<String>,\n    pub expansion_policy_ids: Vec<String>,\n    pub completeness_policy: CompletenessPolicy,\n    pub provenance: Provenance,\n}\n"},{"byte_length":701,"encoding":"utf-8","media_type":"text/x-rust; charset=utf-8","payload_id":"source-payload:sha256:ffb0ad9cb68b8326c9ba3cde16915e6a1ea481f4071a2ccd77b54289af579aa3","sha256":"sha256:82c048c31b6352a9afe084309a1e2800a0f018533b3a945049fef1e752f2d33e","text":"/// One runtime node mapped to governed work.\n#[derive(Clone, Debug, Deserialize, Eq, PartialEq, Serialize)]\n#[serde(deny_unknown_fields)]\npub struct TopologyNode {\n    pub node_id: String,\n    pub work_cell_id: String,\n    pub purpose: String,\n    pub inputs: Vec<NodeInput>,\n    pub outputs: Vec<NodeOutput>,\n    pub side_effects: SideEffects,\n    pub resource_claims: Vec<ResourceClaim>,\n    pub executor_class: String,\n    pub verification_policy_id: Option<String>,\n    pub budget_policy_id: Option<String>,\n    pub idempotency_key: String,\n    pub delivery: DeliveryMode,\n    pub expansion_policy_id: Option<String>,\n    pub estimated_duration_ms: Option<u64>,\n    pub provenance: Provenance,\n}\n"}],"response_schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"disposition":{"additionalProperties":false,"properties":{"detail":{"const":"deterministic.abstain@1 does not evaluate semantic properties"},"kind":{"const":"abstention"},"reason":{"const":"required_evidence_unavailable"}},"required":["kind","reason","detail"],"type":"object"},"schema":{"const":"provider-free.source-grounded-abstention@1"},"source_inventory_id":{"const":"source-inventory:sha256:bf372d7004f5c81c5574bb3f8762e2538d631cf5211b336327c5fe207e283392"},"task_id":{"const":"provider-free-review-task:sha256:ef8346012ea5540fffb529b5b2308c9169a97d01f51d96ef51bce2af25915c5a"}},"required":["schema","task_id","source_inventory_id","disposition"],"type":"object"},"schema":"provider-free.source-gr