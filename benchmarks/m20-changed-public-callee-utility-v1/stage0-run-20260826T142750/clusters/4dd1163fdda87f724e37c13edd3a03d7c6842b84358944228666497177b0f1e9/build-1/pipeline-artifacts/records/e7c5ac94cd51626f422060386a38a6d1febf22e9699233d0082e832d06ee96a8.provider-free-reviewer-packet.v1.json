{"instruction":"Return the fixed provider-free abstention using the supplied closed schema.","payloads":[{"byte_length":205,"encoding":"utf-8","media_type":"text/x-rust; charset=utf-8","payload_id":"source-payload:sha256:2a2832b785ae21bb1045784abd1aeda2d55f208ee0dc6f6dffdf3729b06cefa7","sha256":"sha256:2337b7c73c61bcddb369613f5b2ba69de703649b960db35389408e1ce0f8d43e","text":"#[derive(Clone, Debug, Eq, PartialEq)]\nenum LogicalType {\n    Int,\n    Bool,\n    Named(String),\n    Map(Box<Self>, Box<Self>),\n    Set(Box<Self>),\n    Seq(Box<Self>),\n    Option(Box<Self>),\n    Unknown,\n}\n"},{"byte_length":830,"encoding":"utf-8","media_type":"text/x-rust; charset=utf-8","payload_id":"source-payload:sha256:382ef29b8b1bbda3c1b7135aba444040effe925ccc2fc611969ef1ab187c652d","sha256":"sha256:f6f5e9ffa63f551b6c3f812cbc12ec7b3652c8035f79db812206d2b98e595711","text":"    fn event_assignments(\n        &self,\n        emitted: &[String],\n        span: Span,\n    ) -> Result<Vec<Statement>, CoreError> {\n        for event in emitted {\n            self.event(event, DomainLoc::from(span))?;\n        }\n        let emitted = emitted.iter().map(String::as_str).collect::<BTreeSet<_>>();\n        let mut names = self\n            .domain\n            .aggregates\n            .iter()\n            .flat_map(|aggregate| aggregate.events.iter().map(|event| event.name.as_str()))\n            .collect::<Vec<_>>();\n        names.sort_unstable();\n        Ok(names\n            .into_iter()\n            .map(|name| Statement::Assign {\n                target: LValue::Var(event_flag(name)),\n                value: Expr::Bool(emitted.contains(name)),\n                span,\n            })\n            .collect())\n    }\n"},{"byte_length":39,"encoding":"utf-8","media_type":"text/x-rust; charset=utf-8","payload_id":"source-payload:sha256:417c9c000a9332faeba6802110ed19ba2028bf2023f059ed0aafb5a38e06b7b1","sha256":"sha256:b02ce10b776f9492e663946a0ee7eaee0d58b4784080c655e4209c8260180085","text":"// SPDX-License-Identifier: Apache-2.0\n"},{"byte_length":545,"encoding":"utf-8","media_type":"text/x-rust; charset=utf-8","payload_id":"source-payload:sha256:944bc98407ceb9dee0a6989d47b4c272b4f68efe773cf73d08bb69c5d139448b","sha256":"sha256:17a98b1c85a52101e06d0108fe689c87daa84fc2b56b790a57cb5cb8775b8fb6","text":"/// The kernel one-hot event-occurrence flag name a domain event lowers to\n/// (`event_{event}`). Exported so an external corpus sweep (the #779 saga\n/// step/timeout/compensation \"evolve pairing\" gate) can compute which kernel\n/// variable an event's occurrence flag is from the `DomainSpec` alone,\n/// rather than pattern-matching generated action bodies for an `event_`\n/// prefix — the latter has no `DomainSpec`-side referent to check against.\n#[must_use]\npub fn event_flag(event: &str) -> String {\n    format!(\"event_{}\", safe(event))\n}\n"}],"response_schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"disposition":{"additionalProperties":false,"properties":{"detail":{"const":"deterministic.abstain@1 does not evaluate semantic properties"},"kind":{"const":"abstention"},"reason":{"const":"required_evidence_unavailable"}},"required":["kind","reason","detail"],"type":"object"},"schema":{"const":"provider-free.source-grounded-abstention@1"},"source_inventory_id":{"const":"source-inventory:sha256:bf9dde20111f2316cc69b659264dd09b2cfba9c24e64549fdd8cc09b68d93537"},"task_id":{"const":"provider-free-review-task:sha256:518dacb15fb6cd10c28a17bb152ac20e1e581c1c28c957b1758f6421c9677ab4"}},"required":["schema","task_id","source_inventory_id","disposition"],"type":"object"},"schema":"provider-free.source-grounded-packet@1","source_inventory":{"admitted_sources":[{"bytes":205,"path":"rust/fsl-core/src/domain_lowering.rs","payload_id":"source-payload:sha256:2a2832b785ae21bb1045784abd1aeda2d55f208ee0dc6f6dffdf3729b06cefa7","range":{"end_line":30,"start_line":20},"sha256":"sha256:2337b7c73c61bcddb369613f5