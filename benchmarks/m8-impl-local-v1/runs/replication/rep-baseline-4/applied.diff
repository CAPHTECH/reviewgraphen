+                // A block-local foreign module (`extern "..." { ... }`) is hoisted for the
+                // whole block exactly like a local `fn`/`static`: its `fn` and `static`
+                // declarations put their names in the block's *value* namespace, so each one
+                // shadows a same-named module-level function for any naked call in this block
+                // and must never let such a call fall through to the module item. Only `fn`
+                // and `static` are value-namespace names (a foreign `type` alias is type-only),
+                // so an extern block declaring only other names shadows nothing and blocks no call.
+                syn::Stmt::Item(Item::ForeignMod(foreign)) => {
+                    for item in &foreign.items {
+                        match item {
+                            syn::ForeignItem::Fn(decl) => hoisted.push(decl.sig.ident.to_string()),
+                            syn::ForeignItem::Static(decl) => hoisted.push(decl.ident.to_string()),
+                            _ => {}
+                        }
+                    }
+                }
                 _ => {}
