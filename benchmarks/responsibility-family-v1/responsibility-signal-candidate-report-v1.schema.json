{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reviewgraphen.local/schemas/responsibility-signal-candidate-report-v1.schema.json",
  "title": "ReviewGraphen responsibility-signal pair candidate report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "snapshot_id", "extractor", "profile", "authority", "selection", "denominator", "ignored_high_frequency_terms", "candidates", "information_loss", "unknowns"],
  "properties": {
    "schema": {"const": "reviewgraphen.benchmark.responsibility_signal_candidate_report.v1"},
    "snapshot_id": {"type": "string", "pattern": "^snapshot:"},
    "extractor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rust_anchor_syn_version"],
      "properties": {
        "id": {"const": "reviewgraphen.benchmark.rust-responsibility-signal-pairs@1"},
        "rust_anchor_syn_version": {"type": "string", "minLength": 1}
      }
    },
    "profile": {"$ref": "#/$defs/profile"},
    "authority": {"$ref": "#/$defs/non_authority"},
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal_fact_extractor", "minimum_callable_or_signature_terms", "minimum_operation_terms", "minimum_operation_jaccard_ppm", "max_selective_term_frequency", "frequency_denominator"],
      "properties": {
        "signal_fact_extractor": {"const": "reviewgraphen.ingest.rust-responsibility-signals@1"},
        "minimum_callable_or_signature_terms": {"const": 1},
        "minimum_operation_terms": {"const": 2},
        "minimum_operation_jaccard_ppm": {"const": 600000},
        "max_selective_term_frequency": {"type": "integer", "minimum": 32},
        "frequency_denominator": {"const": "eligible_functions"}
      }
    },
    "denominator": {"$ref": "#/$defs/denominator"},
    "ignored_high_frequency_terms": {"$ref": "#/$defs/signals"},
    "candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate"}
    },
    "information_loss": {"$ref": "#/$defs/text_array"},
    "unknowns": {"$ref": "#/$defs/text_array"}
  },
  "$defs": {
    "count": {"type": "integer", "minimum": 0},
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "text_array": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "term_array": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "matched_operation_array": {
      "allOf": [{"$ref": "#/$defs/term_array"}],
      "minItems": 2
    },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["callable", "signature", "operation"],
      "properties": {
        "callable": {"$ref": "#/$defs/term_array"},
        "signature": {"$ref": "#/$defs/term_array"},
        "operation": {"$ref": "#/$defs/term_array"}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included_path", "included_symbol_kinds", "test_exclusion_fact"],
      "properties": {
        "included_path": {"const": "crates/*/src/**/*.rs | rust/*/src/**/*.rs"},
        "included_symbol_kinds": {"const": ["function", "method"]},
        "test_exclusion_fact": {"const": "artifact.attributes.test_scope=test@reviewgraphen.ingest.rust-test-scope@1"}
      }
    },
    "non_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "accepted", "verified", "human_accepted", "sign_off"],
      "properties": {
        "classification": {"const": "non_authority"},
        "accepted": {"const": false},
        "verified": {"const": false},
        "human_accepted": {"const": false},
        "sign_off": {"const": false}
      }
    },
    "denominator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted_rust_symbols", "eligible_functions", "excluded_non_function_symbols", "excluded_profile_paths", "excluded_test_functions", "excluded_unknown_test_scope", "excluded_missing_shape_fact", "excluded_unknown_signal_fact", "excluded_same_shape_pairs", "evaluated_distinct_shape_pairs", "candidate_pairs", "candidate_members"],
      "properties": {
        "accepted_rust_symbols": {"$ref": "#/$defs/count"},
        "eligible_functions": {"$ref": "#/$defs/count"},
        "excluded_non_function_symbols": {"$ref": "#/$defs/count"},
        "excluded_profile_paths": {"$ref": "#/$defs/count"},
        "excluded_test_functions": {"$ref": "#/$defs/count"},
        "excluded_unknown_test_scope": {"$ref": "#/$defs/count"},
        "excluded_missing_shape_fact": {"$ref": "#/$defs/count"},
        "excluded_unknown_signal_fact": {"$ref": "#/$defs/count"},
        "excluded_same_shape_pairs": {"$ref": "#/$defs/count"},
        "evaluated_distinct_shape_pairs": {"$ref": "#/$defs/count"},
        "candidate_pairs": {"$ref": "#/$defs/count"},
        "candidate_members": {"$ref": "#/$defs/count"}
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "path", "symbol", "start_line", "end_line", "symbol_kind", "signature_shape_hash", "normalized_body_hash", "responsibility_shape_hash"],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^(function|method):"},
        "path": {"type": "string", "pattern": "^(crates|rust)/[^/]+/src/.+\\.rs$"},
        "symbol": {"type": "string", "minLength": 1},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "symbol_kind": {"enum": ["function", "method"]},
        "signature_shape_hash": {"$ref": "#/$defs/hash"},
        "normalized_body_hash": {"$ref": "#/$defs/hash"},
        "responsibility_shape_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "rank", "status", "matched_callable", "matched_signature", "matched_operation", "operation_jaccard_ppm", "members", "unknowns"],
      "anyOf": [
        {"properties": {"matched_callable": {"minItems": 1}}},
        {"properties": {"matched_signature": {"minItems": 1}}}
      ],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^responsibility-family-candidate-signal:sha256:[0-9a-f]{64}$"},
        "rank": {"type": "integer", "minimum": 1},
        "status": {"const": "candidate_only"},
        "matched_callable": {"$ref": "#/$defs/term_array"},
        "matched_signature": {"$ref": "#/$defs/term_array"},
        "matched_operation": {"$ref": "#/$defs/matched_operation_array"},
        "operation_jaccard_ppm": {"type": "integer", "minimum": 600000, "maximum": 1000000},
        "members": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/member"}
        },
        "unknowns": {"$ref": "#/$defs/text_array"}
      }
    }
  }
}
