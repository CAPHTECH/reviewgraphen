{"decisions":[{"disposition":"duplicate","item_id":"adj:sha256:305c144c3d8165bdfdf8ef0df0016a85f4c4bfcaec1a413d31b1e7e43061d9a8","rationale":"Materially identical to adj:sha256:0e39467c33156abdb1c07ae8aac60b1550ddcde7469d9fa3e57a7b65c790e6bb.","schema":"reviewgraphen.benchmark.blind_adjudication.v1"},{"disposition":"duplicate","item_id":"adj:sha256:8454596ea7b17c7b11e594b1759c971bbacb6577a5a5755a5af5a2ad1182c793","rationale":"Materially identical to adj:sha256:0e39467c33156abdb1c07ae8aac60b1550ddcde7469d9fa3e57a7b65c790e6bb.","schema":"reviewgraphen.benchmark.blind_adjudication.v1"},{"disposition":"false_positive","item_id":"adj:sha256:62b6af87eb1afa62898c0246c04760e3fc75d60fbbafd9af2f6c89acc82201f8","rationale":"Each highlighted traversal is breadth-first and keys visitation by the complete state. First discovery has the greatest remaining depth, and every enabled action is examined before child deduplication, so no transition gap is shown.","schema":"reviewgraphen.benchmark.blind_adjudication.v1"},{"disposition":"duplicate","item_id":"adj:sha256:be2dcd660a1b02ead7ec4c1d92dc8a9ffe0533d45280fdfefeeb5739ca7bde4a","rationale":"Materially identical to adj:sha256:532dcaac06535aba4bcf3bb2939e04a0d7be4e2a2414135108ef25530068c074.","schema":"reviewgraphen.benchmark.blind_adjudication.v1"},{"disposition":"valid_novel_defect","item_id":"adj:sha256:0e39467c33156abdb1c07ae8aac60b1550ddcde7469d9fa3e57a7b65c790e6bb","rationale":"The abstract step result is consumed without checking its violation or attempted_state. A failed step retains the prior state, so a failing stuttering transition can compare equal to alpha_after and be accepted.","schema":"reviewgraphen.benchmark.blind_adjudication.v1"},{"disposition":"duplicate","item_id":"adj:sha256:d199718db57e84e03428b7940e277ab1783233587aa6beb3986c2d20a3020a85","rationale":"Materially identical to adj:sha256:0e39467c33156abdb1c07ae8aac60b1550ddcde7469d9fa3e57a7b65c790e6bb.","schema":"reviewgraphen.benchmark.blind_adjudication.v1"},{"disposition":"valid_novel_defect","item_id":"adj:sha256:532dcaac06535aba4bcf3bb2939e04a0d7be4e2a2414135108ef25530068c074","rationale":"For an unsatisfied binding, every nonviolating action sequence is enqueued without a visited or progress key. Cycles and converging paths therefore cause exponential work and memory through the requested depth.","schema":"reviewgraphen.benchmark.blind_adjudication.v1"},{"disposition":"duplicate","item_id":"adj:sha256:375d24cbe935f13451439d6d43c9fe2d6c2e65e57320ca0f062d72e7de18e695","rationale":"Materially identical to adj:sha256:0e39467c33156abdb1c07ae8aac60b1550ddcde7469d9fa3e57a7b65c790e6bb.","schema":"reviewgraphen.benchmark.blind_adjudication.v1"},{"disposition":"false_positive","item_id":"adj:sha256:f3d1952941e24ee214dcf932b6967782b1d1200365658a76843041c895c1b6bf","rationale":"Every supplied initial state is checked before deduplication, each distinct accepted state is enqueued, and descendants are checked after stepping. The shown initialization has no state-transition gap.","schema":"reviewgraphen.benchmark.blind_adjudication.v1"},{"disposition":"duplicate","item_id":"adj:sha256:549e031fa6e33416f3c9a9376c02f2dcb4236a57f4eb3b4ab8f77a3ceb78f452","rationale":"Materially identical to adj:sha256:532dcaac06535aba4bcf3bb2939e04a0d7be4e2a2414135108ef25530068c074.","schema":"reviewgraphen.benchmark.blind_adjudication.v1"},{"disposition":"duplicate","item_id":"adj:sha256:b1f16bbf70a2d71120d4f8b7b3c6cce64079ab0d7c8c08bf9905cd592592261d","rationale":"Materially identical to adj:sha256:532dcaac06535aba4bcf3bb2939e04a0d7be4e2a2414135108ef25530068c074.","schema":"reviewgraphen.benchmark.blind_adjudication.v1"},{"disposition":"duplicate","item_id":"adj:sha256:b1eb77aecf8c904ebcf66299ace1ffe4700a6f8f204572dca13373eed5e7eacf","rationale":"Materially identical to adj:sha256:6a99a05358a5143bab55245278ca4a95dc6628b21c7e84c9f8c6247578d7dee8.","schema":"reviewgraphen.benchmark.blind_adjudication.v1"},{"disposition":"duplicate","item_id":"adj:sha256:d3c780411bf14c2424e01b0516a67833657a4ec8caa4159b5c1448ea2e573c0f","rationale":"Materially identical to adj:sha256:7a41e007fd9b34b373311f8ced374934b4370e795c3867c5986df79004f06b4a.","schema":"reviewgraphen.benchmark.blind_adjudication.v1"},{"disposition":"insufficient","item_id":"adj:sha256:7a41e007fd9b34b373311f8ced374934b4370e795c3867c5986df79004f06b4a","rationale":"The excerpt shows failed step results being excluded, but supplies no contract establishing that response traces must traverse failed attempted states. A cross-component breach cannot be determined.","schema":"reviewgraphen.benchmark.blind_adjudication.v1"},{"disposition":"duplicate","item_id":"adj:sha256:f191415f7f60d1ca09e54a0dbbbb4ac6ea16fbc8e835abe2b919b24dcbc44298","rationale":"Materially identical to adj:sha256:532dcaac06535aba4bcf3bb2939e04a0d7be4e2a2414135108ef25530068c074.","schema":"reviewgraphen.benchmark.blind_adjudication.v1"},{"disposition":"duplicate","item_id":"adj:sha256:d12ba14536e14823d7185886fbf383eb66331c70235072c4b853ff8e2a08ec71","rationale":"Materially identical to adj:sha256:6a99a05358a5143bab55245278ca4a95dc6628b21c7e84c9f8c6247578d7dee8.","schema":"reviewgraphen.benchmark.blind_adjudication.v1"},{"disposition":"insufficient","item_id":"adj:sha256:6a99a05358a5143bab55245278ca4a95dc6628b21c7e84c9f8c6247578d7dee8","rationale":"The binding is cloned before predicate evaluation and the key is not mutated, contradicting token instability; however, the external evaluation contract needed to decide the cross-component allegation is absent.","schema":"reviewgraphen.benchmark.blind_adjudication.v1"},{"disposition":"false_positive","item_id":"adj:sha256:c58a07c48443de378feaeece1fc776eff12461f9ea3c045495a33d8c8961153b","rationale":"The trigger predicate is evaluated against the last state of every dequeued trace before the depth check, and every successful child is queued. The shown code does not omit a reachable state transition.","schema":"reviewgraphen.benchmark.blind_adjudication.v1"}]}