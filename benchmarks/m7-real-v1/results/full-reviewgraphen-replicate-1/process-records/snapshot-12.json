\":178}],\"mechanism_tags\":[\"unstable_token\",\"state_transition_gap\"],\"severity\":\"high\",\"rationale\":\"Non-explicit effect outcomes are classified from substrings in event names. Failure names such as Declined or Rejected therefore default to Succeeded, silently producing the wrong terminal effect transition.\"},{\"local_id\":\"F2\",\"locations\":[{\"path\":\"rust/fsl-core/src/domain_lowering.rs\",\"start_line\":145,\"end_line\":154},{\"path\":\"rust/fsl-tools/src/domain.rs\",\"start_line\":83,\"end_line\":115}],\"mechanism_tags\":[\"unstable_scope_key\",\"cross_file_contract\",\"state_transition_gap\"],\"severity\":\"high\",\"rationale\":\"Effect ownership is keyed only by the globally supplied event name. The tooling then suppresses saga observation whenever any effect claims that name, so shared outcomes or concurrent effect instances can conflate completion ownership and omit the saga transition needed for the specific instance.\"},{\"local_id\":\"F3\",\"locations\":[{\"path\":\"rust/fsl-tools/src/domain.rs\",\"start_line\":31,\"end_line\":43},{\"path\":\"rust/fsl-tools/src/domain.rs\",\"start_line\":218,\"end_line\":270}],\"mechanism_tags\":[\"check_write_gap\",\"cross_file_effect\",\"repeated_effect\"],\"severity\":\"high\",\"rationale\":\"The structural check accepts an irreversible effect whenever an idempotency-key expression is merely present, but the scaffold metadata passed to generation omits that expression and its correlation boundary. Thus a specification can pass the idempotency check without carrying the token needed to suppress repeated runtime effects.\"}],\"obligation_results\":[{\"packet_id\":\"context-envelope:sha256:56a85129c0c847a941615700db82ed645893922fdaa0b5c0f77960d702730e6d\",\"disposition\":\"inconclusive\",\"finding_local_ids\":[]},{\"packet_id\":\"context-envelope:sha256:68334daf099269a1dd5c804650aeb6c3f7a31cd3bd86ea09166bc69106f297de\",\"disposition\":\"issue_present\",\"finding_local_ids\":[\"F1\",\"F3\"]},{\"packet_id\":\