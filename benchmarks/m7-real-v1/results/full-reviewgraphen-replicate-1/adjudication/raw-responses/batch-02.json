{"decisions":[{"disposition":"duplicate","item_id":"adj:sha256:53461f9a83e7d4e835e087512f1087242d9e874951b11df8a4b6a7edf57ca4ae","rationale":"Materially identical to adj:sha256:1e660197383fe76169285a9a7c85dcf1d86aec66bdfc91b2d77ed823839326ce: both concern the predictable literate-materialization path, non-exclusive write, and blind cleanup.","schema":"reviewgraphen.benchmark.blind_adjudication.v1"},{"disposition":"duplicate","item_id":"adj:sha256:63317144efea6797a13761f70e788f3d6f96492b7a80106d0974cd57130ae9e2","rationale":"Materially identical to adj:sha256:1e660197383fe76169285a9a7c85dcf1d86aec66bdfc91b2d77ed823839326ce.","schema":"reviewgraphen.benchmark.blind_adjudication.v1"},{"disposition":"duplicate","item_id":"adj:sha256:7d43f7a59f39071bd25116cc203a46de8ab9c387799efa41a79857003ae1735a","rationale":"Materially identical to adj:sha256:1e660197383fe76169285a9a7c85dcf1d86aec66bdfc91b2d77ed823839326ce.","schema":"reviewgraphen.benchmark.blind_adjudication.v1"},{"disposition":"duplicate","item_id":"adj:sha256:52e0284f1f300518ef806915066c31f6697e3168ba8ed76f441f9bf50378c0cf","rationale":"Materially identical to adj:sha256:1e660197383fe76169285a9a7c85dcf1d86aec66bdfc91b2d77ed823839326ce.","schema":"reviewgraphen.benchmark.blind_adjudication.v1"},{"disposition":"valid_novel_defect","item_id":"adj:sha256:1e660197383fe76169285a9a7c85dcf1d86aec66bdfc91b2d77ed823839326ce","rationale":"The temporary filename is predictably derived only from the source stem and process ID. std::fs::write opens that path non-exclusively and follows an existing symlink, while Drop later removes the path without verifying ownership. A pre-existing entry can therefore be overwritten, including a symlink target, and overlapping materializations of the same source in one process share a path so one guard can delete the other's live file.","schema":"reviewgraphen.benchmark.blind_adjudication.v1"},{"disposition":"duplicate","item_id":"adj:sha256:9a07df98278464836911ef2b5f9aa1220ad677ee0ff1be566a35