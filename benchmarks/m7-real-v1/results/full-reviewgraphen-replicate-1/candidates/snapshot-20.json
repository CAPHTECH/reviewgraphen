{"schema":"reviewgraphen.benchmark.candidate_output.v1","trial_id":"m7-real:snapshot-20:full_review_graphen:1","outcome":"structured","findings":[{"local_id":"scope-overrides-silently-ignored","locations":[{"path":"rust/fsl-core/src/lib.rs","start_line":301,"end_line":313},{"path":"rust/fsl-core/src/lib.rs","start_line":330,"end_line":357},{"path":"rust/fsl-core/src/lib.rs","start_line":369,"end_line":384}],"mechanism_tags":["check_write_gap","state_transition_gap","unstable_scope_key"],"rationale":"The public bounds API validates direct-spec keys only against declarations, but the write path updates only pre-existing VerifyBounds entries and never confirms that each requested override was applied. Business and requirements inputs omit even the key validation. Consequently, an unknown key or a declared key without a matching bounds entry can be silently ignored while the call succeeds, allowing a sweep to verify the original scope while presenting it as the requested scope.","severity":"high"}],"obligation_results":[{"packet_id":"context-envelope:sha256:2d308f1807c49c1d0c8db1e4e9b7e878f2886c83a4fa564981aed6f2ed0bdd9e","disposition":"inconclusive","finding_local_ids":[]},{"packet_id":"context-envelope:sha256:49332f68f44fa259b3d932e9f46704f361b4b4437afce576b69979d552deca9a","disposition":"inconclusive","finding_local_ids":[]},{"packet_id":"context-envelope:sha256:523eee50c8ef2d31793adfb8f561a9464e79188a989943ec140c87634830c6e6","disposition":"inconclusive","finding_local_ids":[]},{"packet_id":"context-envelope:sha256:9f33f8089a5addcc889a7e4f353851d21c5a46381bfbeadff7c9758e182df1d7","disposition":"inconclusive","finding_local_ids":[]},{"packet_id":"context-envelope:sha256:b1ea680881efea689659d6ca01bd3451610f551dede8b17c2cea0aeda0a27b2e","disposition":"issue_present","finding_local_ids":["scope-overrides-silently-ignored"]}]}