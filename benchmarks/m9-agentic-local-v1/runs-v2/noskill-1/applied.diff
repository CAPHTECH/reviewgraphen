+/// The names a block-local `extern` block's declarations put in the enclosing
+/// block's *value* namespace, and whether the block also contains a foreign
+/// declaration shape it cannot reduce to an exact bound name. A foreign `fn`
+/// and a foreign `static` are exactly enumerable and in the value namespace
+/// precisely as a block-local `fn`/`static` item is, so they shadow a
+/// same-named module-level function for a naked call in this block -- scoped
+/// to their own block, never marked conservative on their own. A foreign
+/// `type` declaration is in the *type* namespace only and contributes neither;
+/// any other foreign shape forces the conservative flag (see the match arms).
+/// (A foreign `const` does not exist in Rust -- a `const` in a block is a
+/// block *item*, never a foreign item -- so `fn` and `static` are the only
+/// value-namespace shadows a foreign module can introduce.)
+fn foreign_mod_bindings(module: &ItemForeignMod) -> (Vec<String>, bool) {
+    let mut names = Vec::new();
+    let mut conservative = false;
+    for item in &module.items {
+        match item {
+            ForeignItem::Fn(function) => names.push(function.sig.ident.to_string()),
+            ForeignItem::Static(static_) => names.push(static_.ident.to_string()),
+            // Type-namespace only (never a call target), like a named-field
+            // struct: no shadow, no conservative flag.
+            ForeignItem::Type(_) => {}
+            // `ForeignItem` is `#[non_exhaustive]`, so the wildcard arm is
+            // required and doubles as the fail-closed case: an opaque
+            // `ForeignItem::Macro`/`ForeignItem::Verbatim`, or any variant a
+            // future `syn` release may add, may bind *any* name, so the whole
+            // block becomes conservatively unresolved rather than being
+            // guessed at.
+            _ => conservative = true,
+        }
+    }
+    (names, conservative)
+}
