{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capht.tech/schemas/reviewgraphen/program-space-input.v1.schema.json",
  "title": "ReviewGraphen ProgramSpace Input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "repository",
    "snapshot",
    "profile",
    "artifacts",
    "relations",
    "contexts",
    "invariants",
    "evidence",
    "extraction"
  ],
  "properties": {
    "schema": {
      "const": "reviewgraphen.program_space.input.v1"
    },
    "source": {
      "$ref": "#/$defs/sourceRef"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "type": "string"
        },
        "uri": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "base_revision",
        "target_revision",
        "tree_hash",
        "dirty"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "base_revision": {
          "type": "string",
          "minLength": 1
        },
        "target_revision": {
          "type": "string",
          "minLength": 1
        },
        "tree_hash": {
          "$ref": "#/$defs/hash"
        },
        "dirty": {
          "type": "boolean"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "rule_set_hash",
        "policy_version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "rule_set_hash": {
          "$ref": "#/$defs/hash"
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "contexts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/context"
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/invariant"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/inputEvidence"
      }
    },
    "extraction": {
      "$ref": "#/$defs/extraction"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*:[A-Za-z0-9][A-Za-z0-9_.:@/+-]*$"
    },
    "hash": {
      "type": "string",
      "pattern": "^(sha256|git|blake3):[A-Fa-f0-9]{8,}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "locator"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "git",
            "file",
            "tool",
            "human",
            "model",
            "external",
            "fixture",
            "custom"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string"
        },
        "content_hash": {
          "$ref": "#/$defs/hash"
        },
        "source_local_id": {
          "type": "string"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "extraction_method",
        "review_status"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/sourceRef"
        },
        "extraction_method": {
          "type": "string",
          "minLength": 1
        },
        "tool_version": {
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "review_status": {
          "type": "string",
          "enum": [
            "accepted",
            "unreviewed",
            "human_reviewed",
            "rejected",
            "superseded"
          ]
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "start_column": {
          "type": "integer",
          "minimum": 1
        },
        "end_column": {
          "type": "integer",
          "minimum": 1
        },
        "symbol_id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "limitation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "description",
        "severity"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "type": "string",
          "enum": [
            "capability_missing",
            "parse_failure",
            "unresolved_relation",
            "excluded_region",
            "projection_loss",
            "policy_restriction",
            "unsupported_input",
            "unknown"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        }
      }
    },
    "informationLoss": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reason",
        "recoverable"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "source_count": {
          "type": "integer",
          "minimum": 0
        },
        "projected_count": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "recoverable": {
          "type": "boolean"
        },
        "recoverable_via": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "label",
        "provenance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "type": "string",
          "enum": [
            "repository",
            "snapshot",
            "file",
            "module",
            "package",
            "class",
            "type",
            "function",
            "method",
            "field",
            "route",
            "event",
            "state",
            "api",
            "database",
            "config",
            "permission",
            "test",
            "requirement",
            "policy",
            "owner",
            "external_service",
            "custom"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "content_hash": {
          "$ref": "#/$defs/hash"
        },
        "attributes": {
          "type": "object"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "source_id",
        "target_ids",
        "directed",
        "provenance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "$ref": "#/$defs/identifier"
        },
        "target_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "directed": {
          "type": "boolean"
        },
        "attributes": {
          "type": "object"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "label",
        "member_ids",
        "provenance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "member_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "attributes": {
          "type": "object"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "property_id",
        "description",
        "scope_ids",
        "severity",
        "provenance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "property_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "scope_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "verification_mode": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "inputEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "target_ids",
        "provenance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "target_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "artifact_ref": {
          "type": "string"
        },
        "content_hash": {
          "$ref": "#/$defs/hash"
        },
        "attributes": {
          "type": "object"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_set_hash",
        "adapters",
        "capabilities",
        "limitations"
      ],
      "properties": {
        "adapter_set_hash": {
          "$ref": "#/$defs/hash"
        },
        "adapters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "complete",
                  "partial",
                  "failed",
                  "not_run"
                ]
              },
              "parsed": {
                "type": "integer",
                "minimum": 0
              },
              "total": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "complete",
              "partial",
              "missing",
              "unknown"
            ]
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/limitation"
          }
        }
      }
    }
  }
}
