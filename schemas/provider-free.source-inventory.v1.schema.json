{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://reviewgraphen.dev/schemas/provider-free.source-inventory.v1.schema.json","title":"Provider-free source inventory v1","type":"object","additionalProperties":false,"required":["schema","source_inventory_id","admitted_sources","canonical_sha256"],"properties":{"schema":{"const":"provider-free.source-inventory@1"},"source_inventory_id":{"type":"string","pattern":"^source-inventory:sha256:[0-9a-f]{64}$"},"admitted_sources":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/source"}},"canonical_sha256":{"$ref":"#/$defs/hash"}},"$defs":{"hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"id":{"type":"string","pattern":"^[a-z][a-z0-9-]*:sha256:[0-9a-f]{64}$"},"range":{"type":"object","additionalProperties":false,"required":["start_line","end_line"],"properties":{"start_line":{"type":"integer","minimum":1},"end_line":{"type":"integer","minimum":1}}},"source":{"type":"object","additionalProperties":false,"required":["source_id","path","range","payload_id","bytes","sha256"],"properties":{"source_id":{"$ref":"#/$defs/id"},"path":{"type":"string","minLength":1,"pattern":"^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*//).+$"},"range":{"$ref":"#/$defs/range"},"payload_id":{"$ref":"#/$defs/id"},"bytes":{"type":"integer","minimum":1},"sha256":{"$ref":"#/$defs/hash"}}}}}
