    "proposal": {"type": "object", "additionalProperties": false, "required": ["obligation_id", "execution_id", "property_id", "target_refs", "polarity", "summary", "source_ids", "status"], "properties": {"obligation_id": {"$ref": "#/$defs/id"}, "execution_id": {"$ref": "#/$defs/id"}, "property_id": {"type": "string", "minLength": 1}, "target_refs": {"$ref": "#/$defs/id_set"}, "polarity": {"enum": ["issue_present", "issue_absent", "inconclusive", "not_applicable", "conflict"]}, "summary": {"type": "string", "minLength": 1}, "source_ids": {"$ref": "#/$defs/id_set"}, "status": {"const": "proposed"}}},
