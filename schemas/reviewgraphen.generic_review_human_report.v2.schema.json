    "latent_cardinality": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["state"], "properties": {"state": {"const": "known_zero"}}}, {"type": "object", "additionalProperties": false, "required": ["state", "capability_states", "qualification_ids"], "properties": {"state": {"const": "unknown"}, "capability_states": {"type": "object", "additionalProperties": false, "minProperties": 1, "properties": {"ast": {"enum": ["complete", "partial", "unavailable"]}, "containment": {"enum": ["complete", "partial", "unavailable"]}, "direct_calls": {"enum": ["complete", "partial", "unavailable"]}, "test_mapping": {"enum": ["complete", "partial", "unavailable"]}}}, "qualification_ids": {"type": "array", "uniqueItems": true, "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/id"}}}}]},
