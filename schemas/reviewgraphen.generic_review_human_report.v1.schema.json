{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reviewgraphen.dev/schemas/reviewgraphen.generic_review_human_report.v1.schema.json",
  "title": "ReviewGraphen generic non-authority human report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "audit", "authority", "coverage", "proposed_claims", "abstentions", "malformed_outputs", "provider_failures", "verifier", "exclusions", "deferrals", "source_window_trace", "information_loss", "rendered_markdown_sha256"],
  "properties": {
    "schema": {"const": "reviewgraphen.generic_review_human_report.v1"},
    "audit": {"$ref": "#/$defs/audit"},
    "authority": {"$ref": "#/$defs/authority"},
    "coverage": {"$ref": "#/$defs/coverage"},
    "proposed_claims": {"type": "array", "maxItems": 32768, "items": {"$ref": "#/$defs/proposal"}},
    "abstentions": {"type": "array", "maxItems": 2048, "items": {"$ref": "#/$defs/abstention"}},
    "malformed_outputs": {"type": "array", "maxItems": 2048, "items": {"$ref": "#/$defs/malformed"}},
    "provider_failures": {"type": "array", "maxItems": 2048, "items": {"$ref": "#/$defs/provider_failure"}},
    "verifier": {"$ref": "#/$defs/verifier"},
    "exclusions": {"$ref": "#/$defs/id_set"},
    "deferrals": {"$ref": "#/$defs/id_set"},
    "source_window_trace": {"$ref": "#/$defs/source_window_trace"},
    "information_loss": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/loss"}},
    "rendered_markdown_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*:(?:sha256:[0-9a-f]{64}|[A-Za-z0-9._@:-]+)$"},
    "id_set": {"type": "array", "uniqueItems": true, "maxItems": 32768, "items": {"$ref": "#/$defs/id"}},
    "audit": {"type": "object", "additionalProperties": false, "required": ["schema", "run_id", "snapshot_id", "universe_id", "canonical_sha256"], "properties": {"schema": {"const": "reviewgraphen.generic_review_run.v2"}, "run_id": {"$ref": "#/$defs/id"}, "snapshot_id": {"$ref": "#/$defs/id"}, "universe_id": {"$ref": "#/$defs/id"}, "canonical_sha256": {"$ref": "#/$defs/hash"}}},
    "authority": {"type": "object", "additionalProperties": false, "required": ["classification", "trusted_pass", "result_status", "incomplete_reasons"], "properties": {"classification": {"const": "non_authority"}, "trusted_pass": {"const": false}, "result_status": {"const": "incomplete"}, "incomplete_reasons": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["resolved_target_obligation_ids", "stage_ids", "candidate_space"], "properties": {"resolved_target_obligation_ids": {"$ref": "#/$defs/id_set"}, "stage_ids": {"$ref": "#/$defs/id_set"}, "candidate_space": {"$ref": "#/$defs/candidate_space"}}},
    "candidate_space": {"type": "object", "additionalProperties": false, "required": ["capabilities", "limitation_ids", "gap_obligation_ids", "obstruction_summary_ids", "obstruction_ids", "observed_unresolved_call_occurrence_count", "occurrence_id_set_sha256", "source_occurrence_summaries", "global_direct_calls_limitation", "call_graph_complete", "global_call_coverage_claim"], "properties": {"capabilities": {"type": "object", "additionalProperties": false, "required": ["direct_calls"], "properties": {"direct_calls": {"const": "partial"}}}, "limitation_ids": {"$ref": "#/$defs/id_set"}, "gap_obligation_ids": {"$ref": "#/$defs/id_set"}, "obstruction_summary_ids": {"$ref": "#/$defs/id_set"}, "obstruction_ids": {"$ref": "#/$defs/id_set"}, "observed_unresolved_call_occurrence_count": {"type": "integer", "minimum": 0}, "occurrence_id_set_sha256": {"$ref": "#/$defs/hash"}, "source_occurrence_summaries": {"type": "array", "maxItems": 20000, "items": {"$ref": "#/$defs/occurrence_summary"}}, "global_direct_calls_limitation": {"$ref": "#/$defs/global_direct_calls_limitation"}, "call_graph_complete": {"const": false}, "global_call_coverage_claim": {"const": "prohibited"}}},
    "summary_bucket": {"type": "object", "additionalProperties": false, "required": ["call_kind", "reason", "observed_occurrence_count", "occurrence_id_set_sha256"], "properties": {"call_kind": {"enum": ["direct", "method", "macro_invocation"]}, "reason": {"enum": ["direct_non_path", "direct_empty_path", "direct_shadowed_binding", "direct_unresolved_scope", "direct_target_count_zero", "direct_target_count_multiple", "method_dispatch_unresolved", "macro_expansion_unresolved"]}, "observed_occurrence_count": {"type": "integer", "minimum": 1}, "occurrence_id_set_sha256": {"$ref": "#/$defs/hash"}}, "allOf": [{"if": {"properties": {"call_kind": {"const": "method"}}}, "then": {"properties": {"reason": {"const": "method_dispatch_unresolved"}}}}, {"if": {"properties": {"call_kind": {"const": "macro_invocation"}}}, "then": {"properties": {"reason": {"const": "macro_expansion_unresolved"}}}}, {"if": {"properties": {"call_kind": {"const": "direct"}}}, "then": {"properties": {"reason": {"enum": ["direct_non_path", "direct_empty_path", "direct_shadowed_binding", "direct_unresolved_scope", "direct_target_count_zero", "direct_target_count_multiple"]}}}}]},
    "occurrence_summary": {"type": "object", "additionalProperties": false, "required": ["schema", "id", "kind", "severity", "snapshot_id", "projection_extractor_id", "file_source_id", "path", "related_capabilities", "observed_occurrence_count", "occurrence_id_set_sha256", "buckets", "detail_retention"], "properties": {"schema": {"const": "reviewgraphen.ingestion_obstruction_summary.v1"}, "id": {"$ref": "#/$defs/id"}, "kind": {"const": "call_enumeration_summary"}, "severity": {"const": "medium"}, "snapshot_id": {"$ref": "#/$defs/id"}, "projection_extractor_id": {"const": "reviewgraphen.ingest.rust-call-enumeration@2"}, "file_source_id": {"$ref": "#/$defs/id"}, "path": {"type": "string", "minLength": 1}, "related_capabilities": {"const": ["direct_calls"]}, "observed_occurrence_count": {"type": "integer", "minimum": 1}, "occurrence_id_set_sha256": {"$ref": "#/$defs/hash"}, "buckets": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/summary_bucket"}}, "detail_retention": {"const": "spans_and_owner_sources_omitted_rebuildable"}}},
    "global_direct_calls_limitation": {"type": "object", "additionalProperties": false, "required": ["schema", "id", "snapshot_id", "projection_extractor_id", "kind", "severity", "description", "source_ids", "related_capabilities", "latent_occurrence_count"], "properties": {"schema": {"const": "reviewgraphen.ingestion_global_limitation.v2"}, "id": {"$ref": "#/$defs/id"}, "snapshot_id": {"$ref": "#/$defs/id"}, "projection_extractor_id": {"const": "reviewgraphen.ingest.rust-call-enumeration@2"}, "kind": {"const": "global_direct_calls_limitation"}, "severity": {"const": "info"}, "description": {"const": "direct_calls enumeration is incomplete; macro latent occurrence count is unknown"}, "source_ids": {"$ref": "#/$defs/id_set"}, "related_capabilities": {"const": ["direct_calls"]}, "latent_occurrence_count": {"const": "unknown"}}},
    "proposal": {"type": "object", "additionalProperties": false, "required": ["obligation_id", "execution_id", "property_id", "target_refs", "polarity", "summary", "source_ids", "status"], "properties": {"obligation_id": {"$ref": "#/$defs/id"}, "execution_id": {"$ref": "#/$defs/id"}, "property_id": {"type": "string", "minLength": 1}, "target_refs": {"$ref": "#/$defs/id_set"}, "polarity": {"enum": ["issue_present", "issue_absent", "inconclusive", "not_applicable", "conflict"]}, "summary": {"type": "string", "minLength": 1}, "source_ids": {"$ref": "#/$defs/id_set"}, "status": {"const": "proposed"}}},
    "abstention": {"type": "object", "additionalProperties": false, "required": ["obligation_id", "execution_id", "reason", "detail"], "properties": {"obligation_id": {"$ref": "#/$defs/id"}, "execution_id": {"$ref": "#/$defs/id"}, "reason": {"type": "string", "minLength": 1}, "detail": {"type": "string", "minLength": 1}}},
    "malformed": {"type": "object", "additionalProperties": false, "required": ["obligation_id", "execution_id", "reason", "diagnostic"], "properties": {"obligation_id": {"$ref": "#/$defs/id"}, "execution_id": {"$ref": "#/$defs/id"}, "reason": {"type": "string", "minLength": 1}, "diagnostic": {"type": "string", "minLength": 1}}},
    "provider_failure": {"type": "object", "additionalProperties": false, "required": ["obligation_id", "execution_id", "retryable", "diagnostic"], "properties": {"obligation_id": {"$ref": "#/$defs/id"}, "execution_id": {"$ref": "#/$defs/id"}, "retryable": {"type": "boolean"}, "diagnostic": {"type": "string", "minLength": 1}}},
    "verifier": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"const": "not_selected"}}}, {"type": "object", "additionalProperties": false, "required": ["status", "id", "descriptor_id", "reason", "process_started", "executable_resolved"], "properties": {"status": {"const": "unsupported"}, "id": {"$ref": "#/$defs/id"}, "descriptor_id": {"const": "workspace.cargo_test@1"}, "reason": {"const": "workspace_cargo_test_deferred"}, "process_started": {"const": false}, "executable_resolved": {"const": false}}}]},
    "source_window_trace": {"type": "object", "additionalProperties": false, "required": ["source_ids", "window_ids", "context_ids"], "properties": {"source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "maxItems": 32768, "items": {"$ref": "#/$defs/id"}}, "window_ids": {"$ref": "#/$defs/id_set"}, "context_ids": {"$ref": "#/$defs/id_set"}}},
    "loss": {"type": "object", "additionalProperties": false, "required": ["kind", "meaningful", "reason", "recovery_ref", "source_ids"], "properties": {"kind": {"const": "bounded_audit_reduction"}, "meaningful": {"const": true}, "reason": {"type": "string", "minLength": 1}, "recovery_ref": {"$ref": "#/$defs/hash"}, "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}}
  }
}
