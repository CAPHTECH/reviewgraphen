+/// Topology-bound variant of [`grant_indexed_reservation`] for long-lived
+/// canonical allocators.
+pub fn grant_indexed_topology_reservation(
+    topology: &ExecutionTopology,
+    declaration: &ResourceDeclaration,
+    candidate: &ResourceReservation,
+    occupancy: &ResourceOccupancyIndex,
+    capacities: &[RateLimitCapacity],
+) -> Result<ResourceReservation, Vec<ResourceProtocolFinding>> {
+    let mut findings = validate_resource_declaration(topology, declaration);
+    if let Err(mut grant_findings) =
+        grant_indexed_reservation(declaration, candidate, occupancy, capacities)
+    {
+        findings.append(&mut grant_findings);
+    }
+    findings.sort_by(finding_order);
+    findings.dedup();
+    if findings.is_empty() {
+        Ok(candidate.clone())
+    } else {
+        Err(findings)
+    }
+}
