+/// Canonical derived occupancy used by long-lived allocators. Fields are
+/// private so callers cannot assert occupancy; construct it from canonical
+/// active reservations or let the allocator maintain it after durable events.
+#[derive(Clone, Debug, Default, Eq, PartialEq)]
+pub struct ResourceOccupancyIndex {
+    reservation_ids: BTreeSet<String>,
+    attempt_ids: BTreeSet<String>,
+    resources: BTreeMap<String, ResourceModeOccupancy>,
+    rate_limit_units: BTreeMap<String, u64>,
+}
+
+#[derive(Clone, Debug, Default, Eq, PartialEq)]
+struct ResourceModeOccupancy {
+    readers: BTreeSet<String>,
+    writers: BTreeSet<String>,
+    exclusive: BTreeSet<String>,
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub(crate) enum ResourceOccupancyIndexError {
+    MissingReservationIdentity,
+    MissingAttemptIdentity,
+    MissingResourceHolder(String),
+    MissingRateLimitUsage(String),
+    RateLimitUsageUnderflow(String),
+}
+
+impl ResourceOccupancyIndex {
+    /// Derive occupancy from the exact canonical active reservation set.
+    pub fn from_active_reservations(active: &[ResourceReservation]) -> Self {
+        let mut index = Self::default();
+        for reservation in active {
+            index.insert(reservation);
+        }
+        index
+    }
+
+    pub(crate) fn insert(&mut self, reservation: &ResourceReservation) {
+        self.reservation_ids
+            .insert(reservation.reservation_id.clone());
+        self.attempt_ids.insert(reservation.attempt_id.clone());
+        for grant in &reservation.grants {
+            let holders = self.resources.entry(grant.resource_id.clone()).or_default();
+            match grant.mode {
+                ResourceMode::Read => &mut holders.readers,
+                ResourceMode::Write => &mut holders.writers,
+                ResourceMode::Exclusive => &mut holders.exclusive,
+            }
+            .insert(reservation.reservation_id.clone());
+            if let Some(group) = &grant.rate_limit_group {
+                *self.rate_limit_units.entry(group.clone()).or_default() +=
+                    u64::from(grant.rate_limit_units);
+            }
+        }
+    }
+
+    pub(crate) fn remove(
+        &mut self,
+        reservation: &ResourceReservation,
+    ) -> Result<(), ResourceOccupancyIndexError> {
+        if !self.reservation_ids.contains(&reservation.reservation_id) {
+            return Err(ResourceOccupancyIndexError::MissingReservationIdentity);
+        }
+        if !self.attempt_ids.contains(&reservation.attempt_id) {
+            return Err(ResourceOccupancyIndexError::MissingAttemptIdentity);
+        }
+        for grant in &reservation.grants {
+            let Some(holders) = self.resources.get(&grant.resource_id) else {
+                return Err(ResourceOccupancyIndexError::MissingResourceHolder(
+                    grant.resource_id.clone(),
+                ));
+            };
+            let mode_holders = match grant.mode {
+                ResourceMode::Read => &holders.readers,
+                ResourceMode::Write => &holders.writers,
+                ResourceMode::Exclusive => &holders.exclusive,
+            };
+            if !mode_holders.contains(&reservation.reservation_id) {
+                return Err(ResourceOccupancyIndexError::MissingResourceHolder(
+                    grant.resource_id.clone(),
+                ));
+            }
+            if let Some(group) = &grant.rate_limit_group {
+                let Some(units) = self.rate_limit_units.get(group) else {
+                    return Err(ResourceOccupancyIndexError::MissingRateLimitUsage(
+                        group.clone(),
+                    ));
+                };
+                if units
+                    .checked_sub(u64::from(grant.rate_limit_units))
+                    .is_none()
+                {
+                    return Err(ResourceOccupancyIndexError::RateLimitUsageUnderflow(
+                        group.clone(),
+                    ));
+                }
+            }
+        }
+        self.reservation_ids.remove(&reservation.reservation_id);
+        self.attempt_ids.remove(&reservation.attempt_id);
+        let mut empty_resources = Vec::new();
+        for grant in &reservation.grants {
+            let Some(holders) = self.resources.get_mut(&grant.resource_id) else {
+                return Err(ResourceOccupancyIndexError::MissingResourceHolder(
+                    grant.resource_id.clone(),
+                ));
+            };
+            match grant.mode {
+                ResourceMode::Read => &mut holders.readers,
+                ResourceMode::Write => &mut holders.writers,
+                ResourceMode::Exclusive => &mut holders.exclusive,
+            }
+            .remove(&reservation.reservation_id);
+            if holders.readers.is_empty()
+                && holders.writers.is_empty()
+                && holders.exclusive.is_empty()
+            {
+                empty_resources.push(grant.resource_id.clone());
+            }
+            if let Some(group) = &grant.rate_limit_group {
+                let Some(units) = self.rate_limit_units.get_mut(group) else {
+                    return Err(ResourceOccupancyIndexError::MissingRateLimitUsage(
+                        group.clone(),
+                    ));
+                };
+                let Some(remaining) = units.checked_sub(u64::from(grant.rate_limit_units)) else {
+                    return Err(ResourceOccupancyIndexError::RateLimitUsageUnderflow(
+                        group.clone(),
+                    ));
+                };
+                *units = remaining;
+                if *units == 0 {
+                    self.rate_limit_units.remove(group);
+                }
+            }
+        }
+        for resource in empty_resources {
+            self.resources.remove(&resource);
+        }
+        Ok(())
+    }
+}
